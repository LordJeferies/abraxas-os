#!/bin/bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONT="$ROOT/continuacion en chat"
CMD="${1:-help}"
shift || true

# Cada comando lanzado desde la CLI abre la carpeta de continuidad al terminar.
# Para comandos de larga duración (web/desktop/site), se abrirá cuando el
# proceso se cierre con Ctrl+C o termine.
trap 'open "$CONT" >/dev/null 2>&1 || true' EXIT

case "$CMD" in
  status)
    python3 "$ROOT/scripts/update_continuation.py" >/dev/null
    cat "$CONT/ABRAXAS_OS_CONTINUACION_CHAT.md"
    open "$CONT" >/dev/null 2>&1 || true
    ;;
  check)
    "$ROOT/scripts/check_project.sh"
    ;;
  continuation)
    "$ROOT/scripts/finalize_update.sh" "✅ Continuación actualizada."
    ;;
  checkpoint)
    "$ROOT/scripts/checkpoint.sh" "$@"
    ;;
  web)
    "$ROOT/scripts/run-web.sh"
    ;;
  desktop)
    "$ROOT/scripts/run-desktop.sh"
    ;;
  site)
    echo "Abriendo http://127.0.0.1:8088"
    open "http://127.0.0.1:8088" >/dev/null 2>&1 || true
    cd "$ROOT"
    python3 -m http.server 8088 --directory site
    ;;
  github-check)
    echo "Cuenta:"
    gh auth status || true
    echo
    echo "Remote:"
    git -C "$ROOT" remote -v || true
    echo
    echo "Objetivo:"
    echo "https://github.com/LordJeferies/abraxas-os"
    open "$CONT" >/dev/null 2>&1 || true
    ;;
  f1-validate)
    python3 "$ROOT/scripts/validate_f1_reports.py" "$@"
    "$ROOT/scripts/finalize_update.sh" "F1 validation ejecutada."
    ;;
  media-preflight)
    python3 "$ROOT/scripts/abraxas_media_engine.py" preflight
    ;;
  media-self-test)
    python3 "$ROOT/scripts/abraxas_media_engine.py" self-test
    ;;
  cut)
    if [ "$#" -lt 4 ]; then
      echo 'Uso: ./scripts/abraxas cut SOURCE START END OUTPUT [exact_vt|fast_copy]'
      exit 2
    fi
    SOURCE="$1"
    START="$2"
    END="$3"
    OUTPUT="$4"
    MODE="${5:-exact_vt}"
    python3 "$ROOT/scripts/abraxas_media_engine.py" cut       --source "$SOURCE"       --start "$START"       --end "$END"       --out "$OUTPUT"       --mode "$MODE"
    ;;
  multicut)
    if [ "$#" -lt 1 ]; then
      echo 'Uso: ./scripts/abraxas multicut JOB_JSON'
      exit 2
    fi
    python3 "$ROOT/scripts/abraxas_media_engine.py" multicut --job "$1"
    ;;
  runtime-preflight)
    python3 "$ROOT/scripts/abraxas_source_runtime.py" preflight
    ;;
  runtime-self-test)
    python3 "$ROOT/scripts/abraxas_source_runtime.py" self-test
    ;;
  source-register)
    shift || true
    python3 "$ROOT/scripts/abraxas_source_runtime.py" register "$@"
    ;;
  source-list)
    python3 "$ROOT/scripts/abraxas_source_runtime.py" sources
    ;;
  job-list)
    python3 "$ROOT/scripts/abraxas_source_runtime.py" jobs
    ;;
  worker-once)
    python3 "$ROOT/scripts/abraxas_source_runtime.py" worker-once
    ;;
  github-public)
    "$ROOT/scripts/github_public.sh"
    ;;
  private)
    open "$ROOT/CLIENTES_PRIVADOS_LOCAL"
    ;;
  help|*)
    cat <<'TXT'
ABRAXAS OS CLI

  ./scripts/abraxas status
  ./scripts/abraxas check
  ./scripts/abraxas continuation
  ./scripts/abraxas checkpoint "qué se hizo"
  ./scripts/abraxas web
  ./scripts/abraxas desktop
  ./scripts/abraxas site
  ./scripts/abraxas github-check
  ./scripts/abraxas f1-validate
  ./scripts/abraxas media-preflight
  ./scripts/abraxas media-self-test
  ./scripts/abraxas runtime-preflight
  ./scripts/abraxas runtime-self-test
  ./scripts/abraxas source-register --source PATH --role horizontal_master
  ./scripts/abraxas source-list
  ./scripts/abraxas job-list
  ./scripts/abraxas worker-once
  ./scripts/abraxas cut SOURCE START END OUTPUT [exact_vt|fast_copy]
  ./scripts/abraxas multicut JOB_JSON
  ./scripts/abraxas github-public
  ./scripts/abraxas private

Al terminar checks/checkpoints/publicación se abre automáticamente:
continuacion en chat/
TXT
    ;;
esac
